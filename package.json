{
  "name": "sorteo",
  "version": "1.0.0",
  "description": "1. Abre phpMyAdmin. 2. Importa el archivo [`database.sql`](./database.sql). 3. Verifica que se creo la base `u552541920_futbol` y sus tablas.",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:react",
    "build:css": "tailwindcss -i ./assets/tailwind.input.css -o ./assets/tailwind.css --minify",
    "build:react": "vite build",
    "dev:react": "vite --host 0.0.0.0",
    "test:react-smoke": "playwright test tests/react-partial-smoke.spec.js",
    "test:site-pages": "playwright test tests/site-pages-smoke.spec.js",
    "test:smoke": "npm run test:site-pages && npm run test:spa && npm run test:react-smoke",
    "test:spa": "playwright test tests/spa-progressive-smoke.spec.js",
    "watch:css": "tailwindcss -i ./assets/tailwind.input.css -o ./assets/tailwind.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
}
