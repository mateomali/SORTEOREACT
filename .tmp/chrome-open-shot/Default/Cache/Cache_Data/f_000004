:root {
  --bg-1: #0f2d1f;
  --bg-2: #113f2b;
  --card: #f9fbf8;
  --ink: #1f2a24;
  --primary: #1f7a4c;
  --primary-dark: #155b38;
  --secondary: #f4b942;
  --danger: #b9382a;
  --muted: #6f7d74;
  --line: #dfe8e2;
  --radius: 14px;
  --shadow: 0 10px 25px rgba(3, 25, 16, 0.12);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  color: var(--ink);
  background:
    radial-gradient(circle at 15% 15%, rgba(255, 255, 255, 0.12), transparent 28%),
    radial-gradient(circle at 85% 80%, rgba(255, 255, 255, 0.08), transparent 24%),
    linear-gradient(140deg, var(--bg-1), var(--bg-2));
  min-height: 100vh;
}

.app-shell {
  width: min(1200px, 96%);
  margin: 18px auto 22px;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20px;
  box-shadow: 0 24px 50px rgba(2, 16, 10, 0.35);
  overflow: hidden;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 18px;
  background: linear-gradient(100deg, #0f3624, #185c3a);
  color: #f4fff8;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand strong {
  display: block;
  font-size: 1.05rem;
  letter-spacing: 1px;
}

.brand span {
  display: block;
  font-size: 0.85rem;
  opacity: 0.86;
}

.ball {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 30%, #fff 0 20%, #dce8df 20% 42%, #0a2317 43%),
    #fff;
  border: 2px solid rgba(255, 255, 255, 0.65);
}

.menu-toggle {
  border: 0;
  border-radius: 10px;
  padding: 9px 12px;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  display: none;
}

.main-nav {
  display: flex;
  gap: 6px;
  padding: 10px 12px;
  background: #f0f6f2;
  border-bottom: 1px solid #dde9e0;
  flex-wrap: wrap;
}

.main-nav a {
  text-decoration: none;
  color: #0f3925;
  font-weight: 600;
  font-size: 0.92rem;
  padding: 8px 11px;
  border-radius: 9px;
}

.main-nav a:hover {
  background: #e0efe6;
}

.main-nav a.active {
  background: linear-gradient(100deg, #1f7a4c, #155b38);
  color: #fff;
}

.content {
  padding: 18px;
}

h1, h2, h3 {
  margin-top: 0;
  color: #143d29;
}

.page-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px;
  box-shadow: var(--shadow);
}

.encounter-drawer {
  position: relative;
  margin: 0 0 14px;
  padding-left: 42px;
  min-height: 170px;
}

.encounter-drawer[open] {
  min-height: 0;
}

.encounter-drawer-tab {
  position: absolute;
  left: 0;
  top: 0;
  width: 36px;
  min-height: 170px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #bfd2c4;
  border-radius: 10px;
  background: linear-gradient(180deg, var(--primary), var(--primary-dark));
  color: #fff;
  cursor: pointer;
  list-style: none;
  box-shadow: 0 8px 18px rgba(3, 25, 16, 0.16);
}

.encounter-drawer-tab::-webkit-details-marker {
  display: none;
}

.encounter-drawer-tab span {
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  white-space: nowrap;
  font-weight: 800;
  font-size: 0.85rem;
}

.encounter-drawer-body {
  display: none;
}

.encounter-drawer[open] .encounter-drawer-body {
  display: block;
}

.grid {
  display: grid;
  gap: 14px;
}

.grid.cols-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid.cols-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.stat-box {
  border-radius: 12px;
  border: 1px solid #d7e4da;
  background: linear-gradient(145deg, #ffffff, #f1f8f3);
  padding: 12px;
}

.stat-box .value {
  font-size: 1.45rem;
  font-weight: 800;
  color: #0f5c35;
}

.stat-box .label {
  color: var(--muted);
  font-size: 0.84rem;
}

.stats-filter-menu {
  padding: 0;
}

.stats-filter-menu summary {
  cursor: pointer;
  padding: 13px 14px;
  font-weight: 800;
  color: #143d29;
  list-style: none;
}

.stats-filter-menu summary::-webkit-details-marker {
  display: none;
}

.stats-filter-menu summary::after {
  content: "+";
  float: right;
  color: var(--primary-dark);
}

.stats-filter-menu[open] summary {
  border-bottom: 1px solid var(--line);
}

.stats-filter-menu[open] summary::after {
  content: "-";
}

.stats-filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 180px)) auto;
  align-items: end;
  gap: 12px;
  padding: 14px 14px 4px;
}

.stats-player-search {
  padding: 0 14px 14px;
}

.stats-player-search input {
  max-width: 460px;
}

.stats-search-card {
  margin-bottom: 14px;
}

.stats-search-card .stats-player-search {
  padding: 0;
}

.stats-summary {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.stats-summary span {
  border: 1px solid #d7e4da;
  border-radius: 999px;
  background: #fff;
  color: #294c37;
  font-size: 0.84rem;
  font-weight: 700;
  padding: 7px 10px;
}

.stats-player-result {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}

.stats-player-result[hidden] {
  display: none;
}

.stats-section {
  margin-bottom: 14px;
}

.stats-section h3 {
  margin-bottom: 8px;
}

.stats-table tr.is-highlighted {
  background: #fff7df;
}

.home-next-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 14px;
}

.home-next-card h2 {
  margin-bottom: 4px;
}

.home-kicker {
  display: inline-block;
  color: #1d5f3a;
  font-size: 0.78rem;
  font-weight: 800;
  margin-bottom: 4px;
  text-transform: uppercase;
}

.home-layout {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.match-history {
  order: 2;
}

.match-detail {
  order: 1;
}

.match-list {
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.match-list-item {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  border: 1px solid #d7e4da;
  border-radius: 12px;
  background: #fff;
  color: var(--ink);
  padding: 10px;
  text-decoration: none;
}

.match-list-item:hover,
.match-list-item.active {
  border-color: #8fb99d;
  background: #eef8f1;
}

.match-list-item strong,
.match-list-item small {
  display: block;
}

.match-list-item small {
  color: var(--muted);
  font-size: 0.78rem;
  margin-top: 2px;
}

.match-list-side {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  flex-direction: column;
  flex-shrink: 0;
}

.match-list-side em {
  color: #7a4f08;
  font-size: 0.74rem;
  font-style: normal;
  font-weight: 800;
  text-transform: uppercase;
}

.match-list-side .btn {
  padding: 7px 9px;
  font-size: 0.78rem;
}

.match-detail {
  min-width: 0;
}

.match-detail-head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  margin-bottom: 12px;
}

.match-detail-head h3 {
  margin-bottom: 4px;
}

.score-pill {
  border: 1px solid #bfd2c4;
  border-radius: 999px;
  background: #fff;
  color: #143d29;
  font-weight: 800;
  padding: 8px 11px;
  white-space: nowrap;
}

.public-teams {
  margin-bottom: 14px;
}

.public-player-list {
  max-height: none;
}

.formation-player.empty-slot {
  opacity: 0.62;
}

.match-results {
  margin-top: 14px;
}

.match-awards {
  margin-bottom: 14px;
}

form {
  margin: 0;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.form-row {
  margin-bottom: 10px;
}

label {
  display: block;
  font-weight: 600;
  font-size: 0.9rem;
  margin-bottom: 6px;
}

input[type="text"],
input[type="number"],
input[type="datetime-local"],
input[type="date"],
select,
textarea {
  width: 100%;
  border: 1px solid #c9d9ce;
  border-radius: 10px;
  padding: 10px 11px;
  font-family: inherit;
  font-size: 0.95rem;
  background: #fff;
}

textarea {
  min-height: 90px;
  resize: vertical;
}

.check-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  padding: 8px 11px;
  border: 1px solid #bfd2c4;
  background: #fff;
  font-size: 0.88rem;
}

.chip input {
  margin: 0;
}

.btn-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

button,
.btn {
  border: 0;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 700;
  font-family: inherit;
  text-decoration: none;
  cursor: pointer;
}

.btn-primary {
  background: linear-gradient(100deg, var(--primary), var(--primary-dark));
  color: #fff;
}

.btn-muted {
  background: #e8f0ea;
  color: #214833;
}

.btn-danger {
  background: linear-gradient(100deg, #d04535, #aa3024);
  color: #fff;
}

.btn-warning {
  background: linear-gradient(100deg, #ffcc5b, #f0aa2e);
  color: #50360c;
}

.btn-whatsapp {
  background: linear-gradient(100deg, #25d366, #128c4a);
  color: #fff;
}

.btn-disabled {
  background: #e3e7e4;
  color: #8a978f;
  cursor: not-allowed;
  opacity: 0.78;
}

.section-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.section-toolbar h3 {
  margin: 0;
}

.section-toolbar input[type="text"] {
  width: min(420px, 100%);
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.92rem;
}

th, td {
  padding: 10px 8px;
  border-bottom: 1px solid #dce7df;
  text-align: left;
  vertical-align: top;
}

th {
  font-size: 0.84rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #4a6254;
}

.table-wrap {
  overflow-x: auto;
}

.editable-table th,
.editable-table td {
  vertical-align: middle;
}

.table-input {
  min-width: 130px;
  padding: 8px 9px;
  border-radius: 8px;
}

.table-number {
  min-width: 82px;
  max-width: 98px;
}

.inline-checks {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  min-width: 190px;
}

.mini-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid #bfd2c4;
  border-radius: 999px;
  background: #fff;
  padding: 6px 8px;
  margin: 0;
  font-size: 0.78rem;
  white-space: nowrap;
}

.mini-chip input {
  margin: 0;
}

.badge {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 700;
  background: #dcebe1;
  color: #1d5f3a;
}

.badge.warn {
  background: #f9e3b2;
  color: #7a4f08;
}

.badge.done {
  background: #d0ead8;
  color: #1b6e3f;
}

.flash {
  padding: 10px 12px;
  border-radius: 10px;
  margin-bottom: 10px;
  border: 1px solid transparent;
  font-size: 0.92rem;
}

.flash-success {
  background: #e9f7ee;
  border-color: #c7e9d2;
  color: #1a5d36;
}

.flash-error {
  background: #fdeceb;
  border-color: #f3c4c1;
  color: #7f1f18;
}

.flash-info {
  background: #eaf2fb;
  border-color: #c5d9f5;
  color: #174375;
}

.match-player-grid {
  max-height: 320px;
  overflow: auto;
  border: 1px solid #d2e0d6;
  border-radius: 10px;
  padding: 8px;
  background: #fff;
}

.participant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}

.participant-count {
  border: 1px solid #bfd2c4;
  border-radius: 999px;
  background: #fff;
  color: #214833;
  font-size: 0.86rem;
  font-weight: 600;
  padding: 6px 10px;
}

.participant-search {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.participant-search input[type="text"] {
  flex: 1;
}

.participant-picker-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  gap: 12px;
}

.participant-panel {
  border: 1px solid #d2e0d6;
  border-radius: 12px;
  background: #fff;
  padding: 10px;
  min-width: 0;
}

.participant-panel h4 {
  margin: 0 0 8px;
  color: #143d29;
}

.player-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border-bottom: 1px solid #edf3ef;
  padding: 8px 4px;
  font-size: 0.88rem;
}

.player-picker-item.selected {
  background: #eef8f1;
}

.selected-player-list {
  display: grid;
  gap: 8px;
  max-height: 320px;
  overflow: auto;
}

.selected-player-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border: 1px solid #d7e4da;
  border-radius: 10px;
  background: #eef8f1;
  padding: 8px 9px;
}

.selected-player-item strong,
.selected-player-item small {
  display: block;
}

.selected-player-item small {
  color: var(--muted);
  font-size: 0.78rem;
}

.selected-player-item button {
  padding: 7px 9px;
  border-radius: 8px;
  background: #fdeceb;
  color: #7f1f18;
  white-space: nowrap;
}

.remove-icon {
  display: none;
}

.player-picker-item:last-child {
  border-bottom: 0;
}

.team-card {
  border-radius: 14px;
  border: 1px solid #c7ddcf;
  background: linear-gradient(150deg, #e9f6ed, #e2f0e6);
  padding: 12px;
}

.team-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.team-formation {
  border-radius: 12px;
  padding: 10px;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.1) 0 2px, transparent 2px 100%),
    linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
    linear-gradient(160deg, #1e7d3f, #125f2f);
  background-size: 45px 100%, 100% 27px, 100% 100%;
}

.formation-line {
  display: grid;
  grid-template-columns: 44px 1fr;
  align-items: center;
  gap: 7px;
  margin-bottom: 8px;
}

.formation-line:last-child {
  margin-bottom: 0;
}

.line-label {
  color: #f5fff7;
  text-align: center;
  font-weight: 800;
  font-size: 0.8rem;
}

.line-players {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  justify-content: center;
}

.formation-player {
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 10px;
  background: rgba(2, 28, 10, 0.52);
  color: #fff;
  min-width: 118px;
  padding: 6px 8px;
  text-align: center;
}

.formation-player strong {
  display: block;
  font-size: 0.86rem;
}

.formation-player span {
  font-size: 0.78rem;
  opacity: 0.94;
}

.small-muted {
  color: var(--muted);
  font-size: 0.83rem;
}

.captain-team-list,
.captain-pots {
  display: grid;
  gap: 8px;
}

.captain-pots {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.captain-rule {
  grid-column: 1 / -1;
  border: 1px solid #d7e4da;
  border-radius: 10px;
  background: #f3f7f4;
  color: #294c37;
  padding: 9px 10px;
  font-size: 0.88rem;
  font-weight: 700;
}

.captain-rule.active {
  border-color: #e4c46f;
  background: #fff7df;
  color: #6a4b0c;
}

.captain-link-actions {
  margin-top: 8px;
}

.captain-pot {
  border: 1px solid #d7e4da;
  border-radius: 12px;
  background: #fff;
  padding: 10px;
}

.captain-pot h4 {
  margin: 0 0 8px;
  color: #143d29;
}

.captain-player {
  width: 100%;
  border: 1px solid #c9d9ce;
  border-radius: 10px;
  background: #f9fbf8;
  color: var(--ink);
  padding: 8px 9px;
  text-align: left;
  margin-bottom: 8px;
  cursor: pointer;
}

.captain-player strong,
.captain-player span {
  display: block;
}

.captain-player span {
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 500;
}

.captain-player.picked {
  cursor: default;
  background: #eef8f1;
}

.captain-formation-tools {
  border: 1px solid #d7e4da;
  border-radius: 10px;
  background: #fff;
  padding: 9px;
  margin-bottom: 8px;
}

.captain-formation-tools label {
  margin-bottom: 6px;
}

.captain-formation-tools select {
  width: 100%;
}

.captain-position-select {
  width: 100%;
  margin-top: 7px;
  border: 1px solid #c9d9ce;
  border-radius: 8px;
  padding: 7px 8px;
  font-weight: 700;
  background: #fff;
}

.captain-player:disabled {
  cursor: not-allowed;
  opacity: 0.62;
}

@media (max-width: 980px) {
  .grid.cols-3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats-player-result {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .home-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .menu-toggle {
    display: inline-block;
  }

  .main-nav {
    display: none;
    flex-direction: column;
    padding: 10px;
  }

  .main-nav.open {
    display: flex;
  }

  .content {
    padding: 14px;
  }

  .encounter-drawer {
    padding-left: 0;
    padding-top: 44px;
  }

  .encounter-drawer-tab {
    width: 100%;
    min-height: 36px;
    height: 36px;
  }

  .encounter-drawer-tab span {
    writing-mode: horizontal-tb;
    transform: none;
  }

  .grid.cols-2,
  .grid.cols-3,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .stats-filter-grid {
    grid-template-columns: 1fr;
    padding-bottom: 8px;
  }

  .stats-filter-grid .btn-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .stats-player-search input {
    max-width: none;
  }

  .stats-player-result {
    grid-template-columns: 1fr 1fr;
  }

  .stats-player-result .stat-box {
    padding: 10px;
  }

  .stats-player-result .value {
    font-size: 1.15rem;
  }

  .stats-summary {
    gap: 6px;
  }

  .stats-summary span {
    flex: 1 1 calc(50% - 6px);
    text-align: center;
    padding: 7px 6px;
  }

  .stats-table {
    min-width: 0;
  }

  .stats-table thead {
    display: none;
  }

  .stats-table,
  .stats-table tbody,
  .stats-table tr,
  .stats-table td {
    display: block;
    width: 100%;
  }

  .stats-table tr {
    border: 1px solid #dce7df;
    border-radius: 10px;
    background: #fff;
    margin-bottom: 9px;
    padding: 8px 10px;
  }

  .stats-table td {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid #edf3ef;
    padding: 7px 0;
    text-align: right;
  }

  .stats-table td:last-child {
    border-bottom: 0;
  }

  .stats-table td::before {
    content: attr(data-label);
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-align: left;
    text-transform: uppercase;
  }

  .home-next-card {
    align-items: stretch;
    flex-direction: column;
  }

  .home-next-card .btn {
    text-align: center;
  }

  .match-list-item {
    align-items: stretch;
    flex-direction: column;
  }

  .match-list-side {
    align-items: center;
    flex-direction: row;
    justify-content: space-between;
  }

  .match-list-side .btn {
    min-width: 92px;
    text-align: center;
  }

  .match-detail-head {
    flex-direction: column;
  }

  .score-pill {
    width: 100%;
    text-align: center;
    white-space: normal;
  }

  .formation-player {
    min-width: 100px;
  }

  .participant-search,
  .participant-picker-layout {
    grid-template-columns: 1fr;
  }

  .participant-search {
    align-items: stretch;
    flex-direction: column;
  }

  .selected-player-item button {
    width: 32px;
    height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
  }

  .remove-label {
    display: none;
  }

  .remove-icon {
    display: inline;
  }

  .captain-pots {
    grid-template-columns: 1fr;
  }
}
